{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Absolute factor-view response",
  "description": "Structured response containing exactly one assessment for each factor in the supplied catalog. P columns follow factorOrder; Q is the corresponding column vector for active absolute views.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "targetHorizon",
    "qReturnConvention",
    "factorOrder",
    "factorAssessments",
    "activeFactors",
    "P",
    "Q"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "asOf": { "type": "string", "format": "date" },
    "targetHorizon": { "type": "string", "minLength": 1 },
    "qReturnConvention": { "type": "string", "minLength": 1 },
    "factorOrder": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "factorAssessments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor", "status", "q", "confidence", "evidenceRefs", "rationale"],
            "properties": {
              "factor": { "type": "string", "minLength": 1 },
              "status": { "const": "view" },
              "q": { "type": "number" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "rationale": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor", "status", "q", "confidence", "evidenceRefs", "rationale"],
            "properties": {
              "factor": { "type": "string", "minLength": 1 },
              "status": { "const": "abstain" },
              "q": { "type": "null" },
              "confidence": { "type": "null" },
              "evidenceRefs": { "type": "array", "maxItems": 0 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "activeFactors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "P": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer", "enum": [0, 1] }
      }
    },
    "Q": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": { "type": "number" }
      }
    }
  },
  "example": {
    "schemaVersion": "1",
    "asOf": "2026-10-01",
    "targetHorizon": "12 months",
    "qReturnConvention": "annualized excess return",
    "factorOrder": ["HML", "RMW", "MOM"],
    "factorAssessments": [
      {
        "factor": "HML",
        "status": "view",
        "q": 0.04,
        "confidence": 0.6,
        "evidenceRefs": ["HML_return_12m"],
        "rationale": "Illustrative assessment based on the supplied HML evidence."
      },
      {
        "factor": "RMW",
        "status": "view",
        "q": 0.02,
        "confidence": 0.55,
        "evidenceRefs": ["RMW_return_12m"],
        "rationale": "Illustrative assessment based on the supplied RMW evidence."
      },
      {
        "factor": "MOM",
        "status": "view",
        "q": 0.03,
        "confidence": 0.5,
        "evidenceRefs": ["MOM_return_12m"],
        "rationale": "Illustrative assessment based on the supplied momentum evidence."
      }
    ],
    "activeFactors": ["HML", "RMW", "MOM"],
    "P": [[1, 0, 0], [0, 1, 0], [0, 0, 1]],
    "Q": [[0.04], [0.02], [0.03]]
  }
}
